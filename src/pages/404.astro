---
import Base from "../layouts/Base.astro";
import PageTop from "../components/PageTop.astro";

const title = "Page not found";
const description = "The page you are looking for does not exist.";
---

<Base title={title} description={description} canonicalPath="/404" robots="noindex,nofollow">
  <PageTop
    eyebrow="404"
    title="This page left early."
    lede="The page you requested does not exist or has been moved."
  >
    <a class="d-btn d-btn--light" href="/">Back to the homepage</a>
  </PageTop>
</Base>
