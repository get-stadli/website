---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import FeatureScroll from "../components/sections/FeatureScroll.astro";
import CardGrid from "../components/sections/CardGrid.astro";
import LogoStrip from "../components/sections/LogoStrip.astro";
import DemoCta from "../components/sections/DemoCta.astro";
import { site } from "../content/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: site.locale
};

const features = [
  {
    title: "Sell everything",
    text: "Tickets, merch, food and parking in one checkout, so every fan spends less time in line and more time in the stands.",
    link: { label: "Learn more", href: "/about" },
    mock: "shop" as const
  },
  {
    title: "Know your fans",
    text: "Every purchase builds a single fan profile. Segment by games attended, spend or seat, in a few clicks.",
    link: { label: "Learn more", href: "/about" },
    mock: "audience" as const
  },
  {
    title: "Bring them back",
    text: "Send the right SMS or email to the right fans, at the moment they’re most likely to come back.",
    link: { label: "Learn more", href: "/about" },
    mock: "message" as const
  },
  {
    title: "See what works",
    text: "Live sales and attendance for every event, compared to last season, without exporting a single spreadsheet.",
    link: { label: "Learn more", href: "/about" },
    mock: "chart" as const
  }
];

const cards = [
  {
    image: "/images/photos/card1.webp",
    title: "For fans.",
    text: "A checkout that feels like the game: fast, simple and on their phone.",
    link: { label: "Fan experience", href: "/about" }
  },
  {
    image: "/images/photos/card2.webp",
    title: "For staff.",
    text: "Scanning, sales and reporting that your whole team can run on game night.",
    link: { label: "Operations", href: "/about" }
  },
  {
    image: "/images/photos/card3.webp",
    title: "For the front office.",
    text: "Fan data and marketing that turn one-time buyers into season regulars.",
    link: { label: "Growth", href: "/about" }
  }
];
---

<Base title={site.name} description={site.description} canonicalPath="/" jsonLd={jsonLd}>
  <Hero
    title={site.tagline}
    primary={{ label: "Get a demo", href: site.cta.href }}
    secondary={{ label: "Learn more", href: "#platform" }}
  />

  <div class="d-sheet d-sheet--lap" id="platform">
    <div class="d-wrap">
      <FeatureScroll
        badge="Platform"
        heading="One platform for every event."
        headingGrey="From the first ticket to the last out."
        lede="Ticketing, fan data and marketing that work together."
        items={features}
      />
    </div>
    <div class="d-sheet-corners" aria-hidden="true"></div>
  </div>

  <div class="on-black">
    <div class="d-band">
      <div class="d-wrap">
        <CardGrid
          heading="Built for game night"
          lede="Everyone who makes the event happen, on the same platform."
          cards={cards}
        />
      </div>
    </div>

    <div class="d-band">
      <div class="d-wrap">
        <LogoStrip caption="Trusted by clubs across Québec and Ontario" />
      </div>
    </div>

    <div class="d-band">
      <div class="d-wrap">
        <DemoCta />
      </div>
    </div>
  </div>
</Base>
