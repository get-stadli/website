---
import Base from "../layouts/Base.astro";
import PageTop from "../components/PageTop.astro";
import { site } from "../content/site";

const title = `Legal — ${site.name}`;
---

<Base title={title} description={`Legal information for ${site.name}`} canonicalPath="/legal">
  <PageTop eyebrow="Legal" title="Legal" />

  <div class="d-sheet d-sheet--lap d-sheet--narrow d-sheet--last">
    <div class="d-wrap">
      <article class="prose">
        <p>This website is provided as-is, without any guarantee or warranty.</p>
        <p>Content published on this site may be modified or removed at any time.</p>
        <p>If you have any legal concerns, please contact the site owner.</p>
        {site.author.email && (
          <p>Contact: <a href={`mailto:${site.author.email}`}>{site.author.email}</a></p>
        )}
      </article>
    </div>
    <div class="d-sheet-corners" aria-hidden="true"></div>
  </div>
</Base>
