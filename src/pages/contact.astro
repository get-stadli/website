---
import Base from "../layouts/Base.astro";
import DemoCta from "../components/sections/DemoCta.astro";
import { site } from "../content/site";

const title = `Contact — ${site.name}`;
---

<Base title={title} description={`Book a demo of ${site.name}`} canonicalPath="/contact">
  <div class="on-black contact">
    <div class="d-wrap">
      <DemoCta headingTag="h1" />
    </div>
  </div>
</Base>

<style>
  .contact{
    padding-top: calc(var(--d-header) + clamp(48px, 6vw, 96px));
    padding-bottom: var(--d-section);
  }
</style>
