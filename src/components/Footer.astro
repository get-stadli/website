---
import { site } from "../content/site";

const year = new Date().getFullYear();
const { columns, languages } = site.footer;
---

<footer class="site-footer">
  <div class="d-wrap site-footer__inner">
    <div class="site-footer__top">
      {columns.map((col) => (
        <nav class="site-footer__col" aria-label={col.title}>
          <h2 class="site-footer__title">{col.title}</h2>
          {col.links.map((link) => (
            <a href={link.href} {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
              {link.label}
            </a>
          ))}
        </nav>
      ))}
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__brand">
        <a class="site-logo" href="/" aria-label={`${site.name} home`}>
          <img src="/images/brand/stadli-white.png" alt={site.name} width="101" height="30" />
        </a>
        <span class="site-footer__legal">© {year} {site.name}. All rights reserved.</span>
      </div>
      <nav class="site-lang" aria-label="Language">
        {languages.map((lang) => (
          <a href={lang.href} aria-current={lang.current ? "true" : undefined}>{lang.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
