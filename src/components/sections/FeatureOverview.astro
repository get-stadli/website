---
/**
 * Four numbered columns, each with a title, a short lede and a list of
 * features (title + one line) separated by hairlines.
 */
const { heading, lede, columns } = Astro.props as {
  heading?: string;
  lede?: string;
  columns: {
    title: string;
    lede: string;
    items: { title: string; text: string }[];
  }[];
};
---

<section class="overview">
  {heading && (
    <div class="overview__head">
      <h2 class="d-heading">{heading}</h2>
      {lede && <p class="d-lede">{lede}</p>}
    </div>
  )}

  <ol class="overview__cols">
    {columns.map((col, i) => (
      <li class="overview__col">
        <div class="overview__intro">
          <span class="overview__num">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="overview__title">{col.title}</h3>
          <p class="overview__lede">{col.lede}</p>
        </div>
        <ul class="overview__items">
          {col.items.map((item) => (
            <li>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>

<style>
  .overview{ display: flex; flex-direction: column; gap: clamp(40px, 4.4vw, 64px); color: var(--dc-text); }
  .overview__head{ display: flex; flex-direction: column; gap: 16px; }
  .overview__head .d-lede{ max-width: 34em; }

  .overview__cols{
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 56px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .overview__col{ display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .overview__intro{
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 13.5em;
    padding: 24px;
    border-radius: var(--d-radius-card);
    background: var(--dc-tile);
  }
  .overview__num{ color: var(--dc-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
  .overview__title{
    font-size: clamp(20px, 1.65vw, 24px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .overview__lede{ color: var(--dc-muted); font-size: var(--d-type-small); line-height: 1.5; text-wrap: pretty; }

  .overview__items{ display: flex; flex-direction: column; margin: 0; padding: 0 4px; list-style: none; }
  .overview__items li{ display: flex; flex-direction: column; gap: 6px; padding-block: 18px; border-top: 1px solid var(--d-field); }
  .overview__items li:first-child{ padding-top: 0; border-top: 0; }
  .overview__items h4{ font-size: 15px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; }
  .overview__items p{ color: var(--dc-muted); font-size: 14px; line-height: 1.5; }

  @media (max-width: 1100px){
    .overview__cols{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .overview__intro{ min-height: 0; }
  }
  @media (max-width: 600px){
    .overview__cols{ grid-template-columns: minmax(0, 1fr); }
  }
</style>
