---
/**
 * Full-bleed video hero under the transparent header.
 * Follow it with a `.d-sheet.d-sheet--lap` to get the overlapping white sheet.
 */
const {
  title,
  video = "/video/hero.mp4",
  poster = "/video/hero-poster.jpg",
  primary,
  secondary
} = Astro.props as {
  title: string;
  video?: string;
  poster?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
};
---

<section class="hero">
  <div class="hero__stage" aria-hidden="true">
    <video class="hero__media" src={video} poster={poster} autoplay muted loop playsinline preload="metadata"></video>
  </div>

  <div class="d-wrap hero__copy">
    <h1 class="d-display hero__heading">{title}</h1>
    {(primary || secondary) && (
      <div class="hero__actions">
        {primary && <a class="d-btn d-btn--light" href={primary.href}>{primary.label}</a>}
        {secondary && <a class="d-arrow" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .hero{
    position: relative;
    isolation: isolate;
    display: flex;
    overflow: hidden;
    background: var(--d-black);
    color: #fff;
  }
  .hero__stage{ position: absolute; inset: 0; z-index: -1; }
  .hero__stage::after{
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #0202024d 0%, #0202024d 62%, var(--d-black) 100%);
  }
  .hero__media{ width: 100%; max-width: none; height: 100%; object-fit: cover; }
  .hero__copy{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding-top: clamp(172px, 15.3vw, 220px);
    padding-bottom: calc(var(--d-sheet-lap) + clamp(90px, 8vw, 120px));
  }
  .hero__heading{ max-width: 11em; margin-bottom: calc(-1 * clamp(12px, 1.1vw, 14px)); }
  .hero__actions{ display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .hero__actions .d-arrow{ color: #fff; }

  @media (prefers-reduced-motion: reduce){
    .hero__media{ display: none; }
    .hero__stage{ background: center / cover url("/video/hero-poster.jpg"); }
  }
</style>
