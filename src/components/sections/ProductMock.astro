---
/**
 * Static product illustrations for the feature panels. See mocks.ts for the kinds.
 */
import type { MockKind } from "./mocks";

const { kind } = Astro.props as { kind: MockKind };
---

<div class={`mock mock--${kind}`} aria-hidden="true">
  {kind === "shop" && (
    <div class="mock-phone">
      <div class="mock-phone__notch"></div>
      <div class="mock-phone__bar">
        <span class="mock-avatar">M</span><span>Mariners</span>
      </div>
      <p class="mock-phone__title">Tonight vs Hawks</p>
      <p class="mock-muted">7:05 PM · Lakeshore Park</p>
      <ul class="mock-shop">
        <li><span class="mock-tile" style="background-image:url(/images/photos/card2.webp)"></span><b>Sec 112 · Row F</b><span class="mock-muted">2 seats · $48</span></li>
        <li><span class="mock-tile" style="background-image:url(/images/photos/card1.webp)"></span><b>Home hoodie</b><span class="mock-muted">$65</span></li>
        <li><span class="mock-tile" style="background:#fae8ff"></span><b>Poutine</b><span class="mock-muted">$12</span></li>
        <li><span class="mock-tile" style="background:#cffafe"></span><b>Parking</b><span class="mock-muted">$15</span></li>
      </ul>
    </div>
  )}

  {kind === "audience" && (
    <div class="mock-card mock-audience">
      <div class="mock-audience__row">
        <span class="mock-muted">Where</span>
        <span class="mock-chip"><b>Games this season</b>&nbsp;<span class="mock-muted">at least 5</span></span>
        <span class="mock-muted">and</span>
        <span class="mock-chip mock-muted">+ Add condition</span>
      </div>
      <div class="mock-audience__foot">
        <span class="mock-figure">2,940</span>
        <span class="mock-muted">fans · Weekend regulars</span>
        <span class="mock-btn">Send SMS</span>
      </div>
    </div>
  )}

  {kind === "message" && (
    <div class="mock-phone mock-phone--sms">
      <div class="mock-phone__notch"></div>
      <div class="mock-sms__head"><span class="mock-avatar">LM</span><span>Mariners</span></div>
      <div class="mock-sms__thread">
        <p class="mock-bubble">Rivalry night is Friday 🔥 Your usual seats in 112 are still open. Grab them before Thursday?</p>
        <p class="mock-bubble mock-bubble--out">Yes! 2 please</p>
        <p class="mock-bubble">Done. Tickets are in your wallet. See you at the park ⚾️</p>
      </div>
    </div>
  )}

  {kind === "chart" && (
    <div class="mock-card mock-chart">
      <p class="mock-muted">Tickets sold</p>
      <p class="mock-figure">48,212 <span class="mock-delta">+18%</span></p>
      <svg viewBox="0 0 400 140" preserveAspectRatio="none">
        <line x1="0" y1="40" x2="400" y2="40" stroke="#e6e6e6" />
        <line x1="0" y1="90" x2="400" y2="90" stroke="#e6e6e6" />
        <path d="M0 110 C30 100 50 104 80 104 S120 88 150 90 S190 80 220 82 S250 60 270 64 S285 20 300 22 S320 70 335 66 S370 52 400 48 V140 H0Z" fill="color-mix(in srgb,#3d5afe 12%,transparent)" />
        <path d="M0 110 C30 100 50 104 80 104 S120 88 150 90 S190 80 220 82 S250 60 270 64 S285 20 300 22 S320 70 335 66 S370 52 400 48" fill="none" stroke="#3d5afe" stroke-width="2.5" />
        <path d="M0 112 C60 108 120 104 180 96 S300 84 400 78" fill="none" stroke="#5c5c5c" stroke-width="2" stroke-dasharray="5 5" />
      </svg>
      <div class="mock-chart__axis"><span>May</span><span>June</span><span>July</span><span>Aug</span></div>
      <span class="mock-tip"><b>Rivalry night</b><br />3,204 tickets</span>
    </div>
  )}
  {kind === "ticket" && (
    <div class="mock-phone mock-phone--ticket">
      <div class="mock-phone__notch"></div>
      <div class="mock-phone__bar"><span class="mock-avatar">M</span><span>Mariners</span></div>
      <div class="mock-ticket">
        <p class="mock-phone__title">vs Hawks</p>
        <p class="mock-muted">Fri, Aug 14 · 7:05 PM</p>
        <div class="mock-ticket__seat">
          <span><span class="mock-muted">Section</span><b>112</b></span>
          <span><span class="mock-muted">Row</span><b>F</b></span>
          <span><span class="mock-muted">Seat</span><b>7</b></span>
        </div>
        <div class="mock-qr"></div>
        <p class="mock-ticket__wallet">Add to Wallet</p>
      </div>
    </div>
  )}

  {kind === "orders" && (
    <div class="mock-card mock-orders">
      <div class="mock-orders__head"><b>Orders</b><span class="mock-muted">Today</span></div>
      <ul class="mock-rows">
        <li><span><b>#20418</b> <span class="mock-muted">Julie Tremblay</span></span><span>$96.00</span><span class="mock-pill mock-pill--pos">Paid</span></li>
        <li><span><b>#20417</b> <span class="mock-muted">Marc Gagnon</span></span><span>$412.50</span><span class="mock-pill">Installment 2/4</span></li>
        <li><span><b>#20416</b> <span class="mock-muted">Sophie Roy</span></span><span>$48.00</span><span class="mock-pill mock-pill--neg">Refunded</span></li>
        <li><span><b>#20415</b> <span class="mock-muted">Group · Minor hockey</span></span><span>$720.00</span><span class="mock-pill">Invoice sent</span></li>
      </ul>
    </div>
  )}

  {kind === "profile" && (
    <div class="mock-card mock-profile">
      <div class="mock-profile__head">
        <span class="mock-avatar mock-avatar--lg">JT</span>
        <span><b>Julie Tremblay</b><br /><span class="mock-muted">Season pass · since 2021</span></span>
      </div>
      <div class="mock-profile__stats">
        <span><span class="mock-muted">Lifetime value</span><b class="mock-figure">$2,480</b></span>
        <span><span class="mock-muted">Games this season</span><b class="mock-figure">18</b></span>
      </div>
      <div class="mock-tags"><span class="mock-pill">Family section</span><span class="mock-pill">French</span><span class="mock-pill">Weekend regular</span></div>
    </div>
  )}

  {kind === "prefs" && (
    <div class="mock-card mock-prefs">
      <b>Communication preferences</b>
      <ul class="mock-rows">
        <li><span>Email · Game announcements</span><span class="mock-toggle is-on"></span></li>
        <li><span>SMS · Last-minute offers</span><span class="mock-toggle is-on"></span></li>
        <li><span>Partner offers</span><span class="mock-toggle"></span></li>
        <li><span>Preferred language</span><span class="mock-pill">Français</span></li>
      </ul>
      <p class="mock-muted mock-prefs__note">Consent recorded Jun 2, 2026 · Storefront</p>
    </div>
  )}

  {kind === "ai" && (
    <div class="mock-card mock-ai">
      <p class="mock-bubble mock-bubble--out mock-ai__ask">Which games sold slower than last season?</p>
      <div class="mock-ai__answer">
        <p><b>3 games</b> are behind last season's pace, all on Tuesday nights.</p>
        <div class="mock-bars">
          <span style="--v:.92"><i></i>Fri</span>
          <span style="--v:.85"><i></i>Sat</span>
          <span style="--v:.7"><i></i>Sun</span>
          <span style="--v:.38" class="is-low"><i></i>Tue</span>
        </div>
        <p class="mock-muted">Suggested: an SMS offer to lapsed weekday buyers.</p>
      </div>
    </div>
  )}
</div>

<style>
  .mock{
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
    color: var(--d-ink);
    font-size: clamp(11px, 2.4cqi, 15px);
    line-height: 1.35;
  }
  .mock b{ font-weight: 500; }
  .mock-muted{ color: var(--d-muted); }
  .mock-avatar{
    display: inline-grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: var(--d-ink);
    color: #fff;
    font-size: .8em;
  }
  .mock-card{
    width: 88%;
    padding: 1.6em 1.4em;
    border-radius: var(--d-radius);
    background: #fff;
  }
  .mock-figure{ font-size: 1.9em; font-weight: 500; letter-spacing: -.04em; line-height: 1; }
  .mock-btn{
    margin-left: auto;
    padding: .7em 1.1em;
    border-radius: 6px;
    background: var(--d-ink);
    color: #fff;
    font-weight: 500;
    font-size: .9em;
  }

  /* Phone */
  .mock-phone{
    align-self: start;
    width: min(46%, 320px);
    height: 100%;
    margin-top: 6%;
    padding: 2.6em 1.4em 0;
    border: .55em solid var(--d-ink);
    border-bottom: 0;
    border-radius: 2.6em 2.6em 0 0;
    background: #fff;
    position: relative;
  }
  .mock-phone__notch{
    position: absolute;
    top: .6em;
    left: 50%;
    translate: -50% 0;
    width: 30%;
    height: 1.5em;
    border-radius: 1em;
    background: var(--d-ink);
  }
  .mock-phone__bar{ display: flex; align-items: center; gap: .6em; margin: .6em 0 1.4em; font-weight: 500; }
  .mock-phone__title{ font-size: 1.6em; font-weight: 500; letter-spacing: -.03em; line-height: 1.1; }
  .mock-shop{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4em .9em;
    margin-top: 1.4em;
    padding: 0;
    list-style: none;
  }
  .mock-shop li{ display: flex; flex-direction: column; gap: .15em; }
  .mock-tile{
    aspect-ratio: 1;
    margin-bottom: .6em;
    border-radius: 4px;
    background: center / cover no-repeat var(--d-field);
  }

  /* Audience */
  .mock-audience{ align-self: start; margin-top: 8%; }
  .mock-audience__row{ display: flex; flex-wrap: wrap; align-items: center; gap: .8em 1.2em; padding-bottom: 3.6em; border-bottom: 1px solid var(--d-field); }
  .mock-chip{ padding: .7em 1em; border-radius: 6px; background: var(--d-inset); }
  .mock-audience__foot{ display: flex; align-items: center; gap: .8em; padding-top: 1em; }

  /* SMS */
  .mock-phone--sms{ padding-inline: 0; }
  .mock-sms__head{ display: flex; flex-direction: column; align-items: center; gap: .4em; padding-bottom: 1em; border-bottom: 1px solid var(--d-field); font-weight: 500; }
  .mock-sms__thread{ display: flex; flex-direction: column; gap: .7em; padding: 1.2em 1em; }
  .mock-bubble{ max-width: 85%; padding: .7em 1em; border-radius: 1.1em; background: var(--d-inset); }
  .mock-bubble--out{ align-self: flex-end; background: var(--d-ink); color: #fff; }

  /* Chart */
  .mock-chart{ position: relative; display: flex; flex-direction: column; gap: .4em; }
  .mock-chart svg{ width: 100%; height: auto; margin-top: 1.2em; }
  .mock-delta{ margin-left: .3em; padding: .2em .5em; border-radius: 4px; background: #d1fae5; color: #047857; font-size: .45em; letter-spacing: 0; vertical-align: middle; }
  .mock-chart__axis{ display: flex; justify-content: space-between; color: var(--d-muted); font-size: .85em; }
  .mock-tip{
    position: absolute;
    top: 30%;
    right: 18%;
    padding: .5em .7em;
    border-radius: 6px;
    background: #1a1a1a;
    color: #fff;
    font-size: .85em;
    line-height: 1.3;
  }
  /* Ticket */
  .mock-ticket{ display: flex; flex-direction: column; gap: .3em; }
  .mock-ticket__seat{ display: flex; justify-content: space-between; margin: 1.2em 0; padding: 1em 0; border-block: 1px dashed var(--d-field); }
  .mock-ticket__seat > span{ display: flex; flex-direction: column; gap: .2em; }
  .mock-qr{
    align-self: center;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 4px;
    background:
      repeating-linear-gradient(90deg, var(--d-ink) 0 8%, transparent 8% 14%, var(--d-ink) 14% 18%, transparent 18% 27%),
      repeating-linear-gradient(0deg, transparent 0 9%, #fff 9% 15%);
    background-blend-mode: normal;
    outline: .5em solid #fff;
    box-shadow: 0 0 0 .6em var(--d-ink);
  }
  .mock-ticket__wallet{ align-self: center; margin-top: 1.6em; padding: .6em 1.2em; border-radius: 6px; background: var(--d-ink); color: #fff; font-weight: 500; }

  /* Rows, pills, toggles */
  .mock-rows{ display: flex; flex-direction: column; margin: 1em 0 0; padding: 0; list-style: none; }
  .mock-rows li{ display: flex; align-items: center; justify-content: space-between; gap: 1em; padding: .85em 0; border-top: 1px solid var(--d-field); }
  .mock-orders .mock-rows li{ display: grid; grid-template-columns: 1fr auto 7.5em; }
  .mock-orders .mock-rows li > :last-child{ justify-self: end; }
  .mock-orders__head{ display: flex; justify-content: space-between; }
  .mock-pill{ padding: .25em .6em; border-radius: 5px; background: var(--d-inset); font-size: .85em; white-space: nowrap; }
  .mock-pill--pos{ background: #d1fae5; color: #047857; }
  .mock-pill--neg{ background: #fee2e2; color: #b91c1c; }
  .mock-toggle{ position: relative; flex: none; width: 2.4em; height: 1.4em; border-radius: 1em; background: var(--d-field); }
  .mock-toggle::after{ content: ""; position: absolute; top: .2em; left: .2em; width: 1em; height: 1em; border-radius: 50%; background: #fff; }
  .mock-toggle.is-on{ background: var(--d-ink); }
  .mock-toggle.is-on::after{ left: auto; right: .2em; }
  .mock-prefs__note{ margin-top: .6em; font-size: .85em; }

  /* Profile */
  .mock-profile{ display: flex; flex-direction: column; gap: 1.4em; }
  .mock-profile__head{ display: flex; align-items: center; gap: .9em; }
  .mock-avatar--lg{ width: 3.2em; height: 3.2em; font-size: 1em; }
  .mock-profile__stats{ display: grid; grid-template-columns: 1fr 1fr; gap: 1em; padding-block: 1.2em; border-block: 1px solid var(--d-field); }
  .mock-profile__stats > span{ display: flex; flex-direction: column; gap: .4em; }
  .mock-tags{ display: flex; flex-wrap: wrap; gap: .5em; }

  /* AI */
  .mock-ai{ display: flex; flex-direction: column; gap: 1.2em; }
  .mock-ai__ask{ max-width: 80%; }
  .mock-ai__answer{ display: flex; flex-direction: column; gap: 1em; padding: 1.1em; border-radius: var(--d-radius); background: var(--d-inset); }
  .mock-bars{ display: flex; align-items: flex-end; gap: .8em; height: 7em; }
  .mock-bars > span{ display: flex; flex: 1; flex-direction: column; justify-content: flex-end; gap: .4em; height: 100%; color: var(--d-muted); font-size: .85em; text-align: center; }
  .mock-bars i{ display: block; height: calc(var(--v) * 100%); border-radius: 3px; background: #3d5afe; }
  .mock-bars .is-low i{ background: #ef4444; }
</style>
