---
/**
 * Questions and answers: intro on the left, an accordion on the right.
 * Uses <details>, so it works without JS. The first answer starts open.
 */
const { heading, lede, link, items } = Astro.props as {
  heading: string;
  lede?: string;
  link?: { label: string; href: string };
  items: { question: string; answer: string }[];
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};
---

<section class="faq">
  <div class="faq__intro">
    <h2 class="d-heading">{heading}</h2>
    {lede && <p class="d-lede">{lede}</p>}
    {link && <a class="d-arrow" href={link.href}>{link.label}</a>}
  </div>

  <div class="faq__list">
    {items.map((item, i) => (
      <details class="faq__item" open={i === 0}>
        <summary>{item.question}<span class="faq__icon" aria-hidden="true"></span></summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq{
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: start;
    color: var(--dc-text);
  }
  .faq__intro{ display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .faq__intro .d-lede{ max-width: 26em; }
  .faq__intro .d-arrow{ margin-top: 4px; color: var(--dc-text); }

  .faq__item{ border-bottom: 1px solid var(--d-field); }
  .faq__item:first-child{ border-top: 1px solid var(--d-field); }
  .faq__item summary{
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    list-style: none;
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.02em;
    cursor: pointer;
  }
  .faq__item summary::-webkit-details-marker{ display: none; }
  .faq__icon{ position: relative; flex: none; width: 14px; height: 14px; }
  .faq__icon::before,
  .faq__icon::after{
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -.75px;
    background: currentColor;
    transition: transform var(--d-duration) var(--d-ease);
  }
  .faq__icon::after{ transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after{ transform: rotate(0deg); }
  .faq__item p{ max-width: 36em; margin: -6px 0 0; padding-bottom: 24px; color: var(--dc-muted); font-size: var(--d-type-small); line-height: 1.55; }

  @media (max-width: 800px){
    .faq{ grid-template-columns: minmax(0, 1fr); }
  }
</style>
