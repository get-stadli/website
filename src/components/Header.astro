---
import { site, type SiteNavItem } from "../content/site";

const { nav = site.nav, cta = site.cta } = Astro.props as {
  nav?: SiteNavItem[];
  cta?: SiteNavItem;
};

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const clean = (href: string) => href.split(/[?#]/)[0].replace(/\/$/, "") || "/";
const matches = (href: string) => {
  const target = clean(href);
  return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
};
const isActive = (item: SiteNavItem) =>
  item.children?.length ? item.children.some((child) => matches(child.href)) : matches(item.href);
---

<header class="site-header" data-header>
  <div class="d-wrap site-header__bar">
    <details class="site-menu">
      <summary aria-label="Menu"><span class="site-menu__icon" aria-hidden="true"></span></summary>
      <div class="site-drawer">
        <nav class="d-wrap site-drawer__list" aria-label="Mobile">
          {nav.map((item) =>
            item.children?.length ? (
              <div class="site-drawer__group">
                <p class="site-drawer__title">{item.label}</p>
                {item.children.map((child) => (
                  <a href={child.href} aria-current={matches(child.href) ? "page" : undefined}>{child.label}</a>
                ))}
              </div>
            ) : (
              <a class="site-drawer__top" href={item.href} aria-current={isActive(item) ? "page" : undefined}>{item.label}</a>
            )
          )}
        </nav>
        <div class="d-wrap">
          <a class="d-btn d-btn--light" href={cta.href}>{cta.label}</a>
        </div>
      </div>
    </details>

    <a class="site-logo" href="/" aria-label={`${site.name} home`}>
      <img src="/images/brand/stadli-white.png" alt={site.name} width="101" height="30" />
    </a>

    <nav class="site-nav" aria-label="Primary">
      {nav.map((item) =>
        item.children?.length ? (
          <div class="site-nav__item">
            <a class="site-nav__link" href={item.href} aria-current={isActive(item) ? "page" : undefined}>
              {item.label}
            </a>
            <div class="site-nav__panel">
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={matches(child.href) ? "page" : undefined}>{child.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a class="site-nav__link" href={item.href} aria-current={isActive(item) ? "page" : undefined}>
            {item.label}
          </a>
        )
      )}
    </nav>

    <a class="d-arrow site-demo" href={cta.href}>
      <span class="site-demo__long">{cta.label}</span>
      <span class="site-demo__short">Demo</span>
    </a>
  </div>
</header>

<script>
  // Header turns solid black once the page scrolls under it
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const update = () => header.classList.toggle("is-stuck", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
